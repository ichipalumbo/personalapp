# Ambiente de execucao (opcional)
NODE_ENV=

# Porta do servidor local (opcional - default 5000)
PORT=

# String de conexao do MongoDB
# ATENCAO: no ambiente local, esta URI deve apontar para o banco de desenvolvimento personalapp_dev.
# O banco "test" e producao e nao deve ser usado localmente.
MONGODB_URI=

# Client IDs do Google (aceita lista separada por virgula)
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GIS_CLIENT_ID=

# Client secrets do Google OAuth
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRET=

# Chave usada para criptografar o refresh token do Google Calendar
ENCRYPTION_KEY=

# URL publica HTTPS do backend (usada para webhook do Google Calendar)
BACKEND_URL=

# Timezone padrao para eventos sem timezone explicito
GCAL_TIMEZONE=
